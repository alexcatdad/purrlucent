{
  "name": "purrlucent",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "customElements": "dist/custom-elements.json",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./surfaces": {
      "types": "./dist/types/surfaces/surfaces.css.d.ts",
      "default": "./dist/surfaces.js"
    },
    "./button": {
      "types": "./dist/types/components/button/button.d.ts",
      "default": "./dist/button.js"
    },
    "./sidebar": {
      "types": "./dist/types/components/sidebar/sidebar.d.ts",
      "default": "./dist/sidebar.js"
    },
    "./checkbox": {
      "types": "./dist/types/components/checkbox/checkbox.d.ts",
      "default": "./dist/checkbox.js"
    },
    "./radio-group": {
      "types": "./dist/types/components/radio-group/radio-group.d.ts",
      "default": "./dist/radio-group.js"
    },
    "./input": {
      "types": "./dist/types/components/input/input.d.ts",
      "default": "./dist/input.js"
    },
    "./slider": {
      "types": "./dist/types/components/slider/slider.d.ts",
      "default": "./dist/slider.js"
    },
    "./progress": {
      "types": "./dist/types/components/progress/progress.d.ts",
      "default": "./dist/progress.js"
    },
    "./spinner": {
      "types": "./dist/types/components/spinner/spinner.d.ts",
      "default": "./dist/spinner.js"
    },
    "./switch": {
      "types": "./dist/types/components/switch/switch.d.ts",
      "default": "./dist/switch.js"
    },
    "./toggle-group": {
      "types": "./dist/types/components/toggle-group/toggle-group.d.ts",
      "default": "./dist/toggle-group.js"
    },
    "./toolbar": {
      "types": "./dist/types/components/toolbar/toolbar.d.ts",
      "default": "./dist/toolbar.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cem analyze",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" playwright.config.ts && stylelint --allow-empty-input \"src/**/*.css\" && bun scripts/style-check.ts",
    "fmt:check": "bun fmt --check",
    "typecheck": "tsc",
    "prepare": "lefthook install",
    "hig:check": "bun scripts/hig-check.ts check",
    "hig:rubric": "bun scripts/hig-check.ts rubric",
    "notices": "bun scripts/third-party-notices.ts",
    "changeset": "changeset",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@guidepup/guidepup": "0.40.0",
    "@guidepup/playwright": "0.21.0",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/web-components-vite": "10.6.8",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "lefthook": "2.2.2",
    "playwright": "1.65.1",
    "storybook": "10.6.8",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "lit": "3.3.3"
  }
}
