  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cem analyze && bun scripts/react-types.ts && bun scripts/agent-skill.ts",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" playwright.config.ts && stylelint --allow-empty-input \"src/**/*.css\" && bun scripts/style-check.ts",
    "fmt:check": "bun fmt --check",
    "typecheck": "tsc",
    "prepare": "lefthook install",
    "hig:check": "bun scripts/hig-check.ts check",
    "hig:rubric": "bun scripts/hig-check.ts rubric",
    "hig:review": "bun scripts/rubric-prompt.ts review origin/main",
    "notices": "bun scripts/third-party-notices.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun fmt CHANGELOG.md",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
