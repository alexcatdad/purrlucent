{
  "name": "purrlucent",
  "version": "0.8.0",
  "description": "Accessible web components built with Lit: form controls, menus, dialogs and navigation for any framework, following Apple's Human Interface Guidelines.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "accessibility",
    "react"
  ],
  "homepage": "https://alexcatdad.github.io/purrlucent/",
